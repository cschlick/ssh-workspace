#!/usr/bin/env bash

set -u

program="${0##*/}"
username=""
session="workspace"
port=""
identity=""
term_type="xterm-256color"
reconnect=1
mode="auto"
start_command=""
session_given=0
list_only=0
do_update=0
resuming=0

update_url="${SSH_WORKSPACE_UPDATE_URL:-https://raw.githubusercontent.com/cschlick/ssh-workspace/main/ssh-workspace}"
picked_mux=""

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/ssh-workspace"
state_file="$state_dir/last"

# User-supplied -o options; placed before the defaults on the command
# line because ssh uses the first value given for each option.
extra_opts=()

# -tt is added only for the attach command; the session listing runs
# without a pseudo-terminal so its output stays clean.
ssh_args=(
    -o ServerAliveInterval=15
    -o ServerAliveCountMax=2
    -o ConnectTimeout=10
    -o ConnectionAttempts=1
)

# Share one SSH connection between the session listing and the attach,
# so the picker costs no extra round-trip or auth prompt.
if mkdir -p "$state_dir" 2>/dev/null && chmod 700 "$state_dir" 2>/dev/null; then
    ssh_args+=(
        -o ControlMaster=auto
        -o "ControlPath=$state_dir/cm-%C"
        -o ControlPersist=30
    )
fi

save_state() {
    local i
    {
        printf 'target=%s\n' "$target"
        printf 'session=%s\n' "$session"
        printf 'mode=%s\n' "${picked_mux:-$mode}"
        printf 'term=%s\n' "$term_type"
        [[ -z "$port" ]] || printf 'port=%s\n' "$port"
        [[ -z "$identity" ]] || printf 'identity=%s\n' "$identity"
        [[ -z "$start_command" ]] || printf 'cmd=%s\n' "$start_command"
        for ((i = 1; i < ${#extra_opts[@]}; i += 2)); do
            printf 'opt=%s\n' "${extra_opts[i]}"
        done
    } > "$state_file" 2>/dev/null || :
}

# Load the last workspace; explicit command-line options win over
# saved values.
load_state() {
    local key value
    local -a saved_opts

    saved_target=""
    saved_opts=()

    [[ -r "$state_file" ]] || return 1

    while IFS='=' read -r key value; do
        case "$key" in
            target) saved_target="$value" ;;
            session)
                [[ "$session_given" -eq 1 ]] || session="$value"
                ;;
            mode)
                [[ "$mode" != auto ]] || mode="$value"
                ;;
            term)
                [[ "$term_type" != xterm-256color ]] || term_type="$value"
                ;;
            port)
                [[ -n "$port" ]] || port="$value"
                ;;
            identity)
                [[ -n "$identity" ]] || identity="$value"
                ;;
            cmd)
                [[ -n "$start_command" ]] || start_command="$value"
                ;;
            opt) saved_opts+=(-o "$value") ;;
        esac
    done < "$state_file"

    [[ -n "$saved_target" ]] || return 1

    if [[ ${#extra_opts[@]} -eq 0 && ${#saved_opts[@]} -gt 0 ]]; then
        extra_opts=("${saved_opts[@]}")
    fi
}

# Replace this script, at whatever path it is installed, with the
# latest version from GitHub. The new file is written next to the old
# one and swapped in with mv, which is atomic and safe to do while
# this copy is still executing.
self_update() {
    local self dir tmp first_line reply

    self=$0
    if [[ "$self" != */* ]]; then
        self=$(command -v -- "$self") ||
            die "cannot determine my own location"
    fi
    dir=$(cd "$(dirname "$self")" && pwd) ||
        die "cannot resolve directory of $self"
    self="$dir/$(basename "$self")"

    [[ -w "$dir" && -w "$self" ]] ||
        die "no write permission on $self"

    tmp=$(mktemp "$dir/.ssh-workspace-update.XXXXXX") ||
        die "cannot create a temporary file in $dir"
    trap 'rm -f "$tmp"' EXIT

    if command -v curl >/dev/null 2>&1; then
        curl -fsSL "$update_url" -o "$tmp"
    elif command -v wget >/dev/null 2>&1; then
        wget -qO "$tmp" "$update_url"
    else
        die "updating needs curl or wget"
    fi || die "download failed: $update_url"

    # Refuse to install anything that is not a runnable bash script.
    read -r first_line < "$tmp" || :
    if [[ ! -s "$tmp" || "$first_line" != '#!'*bash* ]] ||
        ! bash -n "$tmp" 2>/dev/null; then
        die "downloaded file does not look like this script; not installing"
    fi

    if cmp -s "$tmp" "$self"; then
        printf 'Already up to date.\n'
        exit 0
    fi

    printf 'Update source: %s\n' "$update_url"
    printf 'Will replace:  %s\n' "$self"
    if [[ -t 0 && -t 1 ]]; then
        printf 'Proceed? [y/N] '
        read -r reply
        case "$reply" in
            y|Y|yes|Yes|YES) ;;
            *)
                printf 'Update cancelled.\n'
                exit 0
                ;;
        esac
    fi

    if ! chmod +x "$tmp" || ! mv "$tmp" "$self"; then
        die "failed to install update over $self"
    fi

    trap - EXIT
    printf 'Updated %s.\n' "$self"
    exit 0
}

usage() {
    cat <<USAGE
Usage:
  $program [options] HOST
  $program [options] USER@HOST
  $program              (no host: reconnect to the last workspace)

Without -s, existing workspaces on the host are listed so you can pick
one by number or type a name; non-interactive runs use "workspace".

Options:
  -u USER       SSH username
  -s SESSION    Session name; skips the interactive picker
  -l            List workspaces on HOST and exit
  -U            Replace this script with the latest from GitHub and exit
  -m MODE       Multiplexer: auto, tmux, or screen (default: auto —
                use tmux if the remote host has it, else GNU Screen)
  -p PORT       SSH port (default: SSH config or 22)
  -i FILE       SSH identity file
  -o OPTION     Additional SSH option; may be repeated
  -e TERM       Terminal type (default: xterm-256color)
  -c COMMAND    Run COMMAND when the session is first created (the
                session ends when it exits; append '; exec \$SHELL'
                to drop to a shell afterwards)
  -n            Do not reconnect automatically
  -h            Show this help

Examples:
  $program picomol
  $program root@picomol
  $program -u root picomol
  $program -s claude root@picomol
  $program -p 2222 -s admin alice@example.com
  $program -o ProxyJump=bastion root@internal-server
USAGE
}

die() {
    printf '%s: %s\n' "$program" "$*" >&2
    exit 2
}

while getopts ":u:s:m:p:i:o:e:c:lnUh" option; do
    case "$option" in
        u) username="$OPTARG" ;;
        s)
            session="$OPTARG"
            session_given=1
            ;;
        m) mode="$OPTARG" ;;
        p) port="$OPTARG" ;;
        i) identity="$OPTARG" ;;
        o) extra_opts+=(-o "$OPTARG") ;;
        c) start_command="$OPTARG" ;;
        l) list_only=1 ;;
        U) do_update=1 ;;
        e) term_type="$OPTARG" ;;
        n) reconnect=0 ;;
        h)
            usage
            exit 0
            ;;
        :)
            die "option -$OPTARG requires an argument"
            ;;
        \?)
            die "unknown option: -$OPTARG"
            ;;
    esac
done

shift $((OPTIND - 1))

if [[ "$do_update" -eq 1 ]]; then
    self_update
fi

case $# in
    0)
        [[ -z "$username" ]] ||
            die "-u requires a HOST argument"
        load_state || {
            usage >&2
            exit 2
        }
        resuming=1
        ;;
    1)
        host="$1"
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac

case "$mode" in
    auto|tmux|screen) ;;
    *)
        die "invalid mode: $mode (use auto, tmux, or screen)"
        ;;
esac

# Restrict values embedded in the remote shell command to safe characters.
case "$session" in
    ""|*[!A-Za-z0-9_.-]*)
        die "session name may contain only letters, numbers, dots, underscores, and hyphens"
        ;;
esac

# tmux reserves dots in session names for its window.pane target syntax.
if [[ "$mode" != screen && "$session" == *.* ]]; then
    die "session names with dots only work with -m screen"
fi

# printf %q escapes control characters in a bash-only syntax that the
# remote shell may not understand; everything else it escapes portably.
if [[ "$start_command" == *[$'\n\t']* ]]; then
    die "-c command may not contain newlines or tabs"
fi

case "$term_type" in
    ""|*[!A-Za-z0-9_.+-]*)
        die "invalid terminal type"
        ;;
esac

if [[ -n "$port" ]]; then
    case "$port" in
        *[!0-9]*|"")
            die "port must be numeric"
            ;;
    esac
    ssh_args+=(-p "$port")
fi

if [[ -n "$identity" ]]; then
    ssh_args+=(-i "$identity")
fi

if [[ "$resuming" -eq 1 ]]; then
    target="$saved_target"
elif [[ -n "$username" ]]; then
    [[ "$host" != *@* ]] ||
        die "do not combine -u USER with USER@HOST"
    target="${username}@${host}"
else
    target="$host"
fi

try_tmux=false
try_screen=false
case "$mode" in
    auto)
        try_tmux=true
        try_screen=true
        ;;
    tmux)
        try_tmux=true
        ;;
    screen)
        try_screen=true
        ;;
esac

list_command="
if $try_tmux && command -v tmux >/dev/null 2>&1; then
    printf 'tmux\n'
    tmux list-sessions -F '#{?session_attached,attached,detached} #S' 2>/dev/null
    exit 0
fi

if $try_screen && command -v screen >/dev/null 2>&1; then
    printf 'screen\n'
    screen -ls 2>/dev/null | awk '/^[ \t]+[0-9]+\./ {
        name = \$1
        sub(/^[0-9]+\./, \"\", name)
        print (index(\$0, \"Attached\") ? \"attached\" : \"detached\") \" \" name
    }'
    exit 0
fi

exit 127
"

list_sessions() {
    # shellcheck disable=SC2029  # client-side expansion is intentional
    ssh ${extra_opts[@]+"${extra_opts[@]}"} "${ssh_args[@]}" \
        "$target" "$list_command"
}

if [[ "$list_only" -eq 1 ]]; then
    list_output=$(list_sessions)
    status=$?
    if [[ "$status" -ne 0 ]]; then
        [[ "$status" -ne 127 ]] ||
            printf '%s: no terminal multiplexer on %s (mode: %s)\n' \
                "$program" "$target" "$mode" >&2
        exit "$status"
    fi

    mux=""
    count=0
    while IFS= read -r line; do
        if [[ -z "$mux" ]]; then
            case "$line" in
                tmux|screen) mux="$line" ;;
            esac
            continue
        fi
        [[ "$line" == *" "* ]] || continue
        [[ "$count" -gt 0 ]] ||
            printf 'Workspaces on %s (%s):\n' "$target" "$mux"
        printf '  %s (%s)\n' "${line#* }" "${line%% *}"
        count=$((count + 1))
    done <<< "$list_output"

    [[ -n "$mux" ]] || die "unexpected listing output from $target"
    [[ "$count" -gt 0 ]] ||
        printf 'No workspaces on %s (%s).\n' "$target" "$mux"
    exit 0
fi

# List sessions on the remote host and let the user pick one by number
# or type a name. Any failure (connection error, no multiplexer) falls
# through silently; the attach loop reports errors properly.
pick_session() {
    local list_output mux line reply candidate count i
    local -a names states

    list_output=$(list_sessions) || return 0

    mux=""
    names=()
    states=()
    while IFS= read -r line; do
        if [[ -z "$mux" ]]; then
            case "$line" in
                tmux|screen) mux="$line" ;;
            esac
            continue
        fi
        [[ "$line" == *" "* ]] || continue
        states+=("${line%% *}")
        names+=("${line#* }")
    done <<< "$list_output"

    [[ -n "$mux" ]] || return 0
    picked_mux="$mux"

    count=${#names[@]}

    if [[ "$count" -eq 0 ]]; then
        printf 'No existing workspaces on %s (%s).\n' "$target" "$mux"
        printf 'New session name [%s]: ' "$session"
    else
        printf 'Workspaces on %s (%s):\n' "$target" "$mux"
        for ((i = 0; i < count; i++)); do
            printf '  %d) %s (%s)\n' "$((i + 1))" "${names[i]}" "${states[i]}"
        done
        printf 'Select a number, or type a session name [1]: '
    fi

    while :; do
        read -r reply || return 0

        if [[ -z "$reply" ]]; then
            if [[ "$count" -gt 0 ]]; then
                candidate="${names[0]}"
            else
                candidate="$session"
            fi
        elif [[ "$reply" != *[!0-9]* && "$count" -gt 0 &&
                "$reply" -ge 1 && "$reply" -le "$count" ]]; then
            candidate="${names[reply - 1]}"
        else
            candidate="$reply"
        fi

        case "$candidate" in
            ""|*[!A-Za-z0-9_.-]*)
                printf 'Names may contain only letters, numbers, dots, underscores, and hyphens.\n'
                printf 'Session name: '
                continue
                ;;
        esac

        if [[ "$mux" == tmux && "$candidate" == *.* ]]; then
            printf 'tmux session names may not contain dots.\n'
            printf 'Session name: '
            continue
        fi

        session="$candidate"
        return 0
    done
}

if [[ "$session_given" -eq 0 && "$resuming" -eq 0 && -t 0 && -t 1 ]]; then
    pick_session
fi

# The startup command runs only when the session is created; both
# multiplexers ignore it when attaching to an existing session.
start_tmux=""
start_screen=""
if [[ -n "$start_command" ]]; then
    start_quoted=$(printf '%q' "$start_command")
    start_tmux=" $start_quoted"
    start_screen=" sh -c $start_quoted"
fi

# tmux: -A attaches if the session exists (else creates it); with -A,
# -D detaches other clients. screen -D -RR does the same.
remote_command="
if $try_tmux && command -v tmux >/dev/null 2>&1; then
    exec env TERM=$term_type tmux new-session -A -D -s $session$start_tmux
fi

if $try_screen && command -v screen >/dev/null 2>&1; then
    exec env TERM=$term_type screen -D -RR -S $session$start_screen
fi

printf '%s\n' \
    'No usable terminal multiplexer on this host (mode: $mode).' \
    'On Debian/Ubuntu: sudo apt install tmux (or: sudo apt install screen)' >&2
exit 127
"

retry_delay=2
max_retry_delay=60
fast_failures=0
max_fast_failures=3

# Prepended to the remote command on reconnect attempts only: rings the
# local terminal bell once the connection is re-established, so a
# backgrounded tab gets a badge when the workspace comes back.
attach_notice=""

while :; do
    # Label the terminal tab with the workspace.
    [[ ! -t 1 ]] || printf '\033]0;%s\007' "$target:$session"

    printf 'Connecting to %s — session: %s\n' "$target" "$session"

    # Setting TERM locally makes SSH advertise xterm-256color when it
    # allocates the remote pseudo-terminal. The remote command sets it again.
    started=$SECONDS
    env TERM="$term_type" \
        ssh -tt ${extra_opts[@]+"${extra_opts[@]}"} "${ssh_args[@]}" \
        "$target" "$attach_notice$remote_command"

    status=$?
    duration=$((SECONDS - started))

    case "$status" in
        0)
            # The session was intentionally detached or its shell was exited.
            save_state
            printf 'Workspace detached or ended.\n'
            exit 0
            ;;

        127)
            # No multiplexer on the remote host.
            exit 127
            ;;

        255)
            # SSH uses 255 for transport, connection, and authentication errors.
            if [[ "$reconnect" -eq 0 ]]; then
                exit 255
            fi

            attach_notice="printf '\a' >&2
"

            # A session that stayed up for a while was a real connection
            # that dropped; remember it and restart the retry sequence
            # from scratch. Failed connects never overwrite saved state.
            if [[ "$duration" -ge 30 ]]; then
                save_state
                retry_delay=2
                fast_failures=0
            fi

            # Failing within seconds means auth rejection or connection
            # refused, not an outage; retrying on a timer won't help.
            if [[ "$duration" -lt 3 ]]; then
                fast_failures=$((fast_failures + 1))
            else
                fast_failures=0
            fi

            if [[ "$fast_failures" -ge "$max_fast_failures" ]]; then
                printf '\nConnection is failing immediately — check credentials, host, and sshd.\n'
            elif [[ "$retry_delay" -gt "$max_retry_delay" ]]; then
                printf '\nStill unable to reach %s.\n' "$target"
            else
                printf '\nSSH connection lost. Reconnecting in %d seconds; press Ctrl-C to stop.\n' \
                    "$retry_delay"
                sleep "$retry_delay"
                retry_delay=$((retry_delay * 2))
                continue
            fi

            # Retries are exhausted; hand control back to the user.
            printf '\aPress Enter to resume retrying, or Ctrl-C to quit. '
            read -r _ || exit 255
            retry_delay=2
            fast_failures=0
            ;;

        *)
            printf '\nRemote command exited with status %d; not reconnecting.\n' \
                "$status" >&2
            exit "$status"
            ;;
    esac
done
